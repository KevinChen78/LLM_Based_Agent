# Copy this file to .env.local and fill in your real credentials.
# .env.local is gitignored. Real environment variables override this file.
#
# When LLM_API_KEY is empty, the gateway runs in deterministic-stub mode
# (no network calls). Set it to enable real-LLM passthrough.

LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECS=20
