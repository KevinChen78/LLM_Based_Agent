# Retrieval service config. Copy to .env.local (gitignored) to override.
# Real environment variables always take precedence.
# NOTE: the env loader uses setdefault and reads .env BEFORE .env.local, so a
# key set in .env wins over .env.local — define each key in exactly one file.

RETRIEVAL_PORT=8001

# Storage backend: postgres (default; needs psycopg + a seeded groupbuy DB,
# see sql/README.md) or json (pure stdlib, reads the files below).
# If postgres is unavailable at startup the service degrades to json with a
# warning — check the "backend" field of GET /v1/health.
RETRIEVAL_BACKEND=postgres

# libpq conninfo for the postgres backend. Empty => libpq reads the standard
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD variables instead.
# PG_DSN=host=127.0.0.1 port=5432 dbname=groupbuy user=agent password=changeme
PG_DSN=

# Paths are relative to the project root by default; override if needed.
# (json backend + scripts/pg_seed.py source data)
DEALS_PATH=../data/deals.json
KB_PATH=../data/knowledge.json

# gRPC front-end (Phase 5-D pilot): same process, same handlers as HTTP,
# contract in proto/retrieval.proto. Empty = off. Needs grpcio installed.
# Point the api_server at it with RETRIEVAL_PROTOCOL=grpc +
# RETRIEVAL_GRPC_ADDR=127.0.0.1:8011 (any gRPC failure falls back to HTTP).
GRPC_PORT=
