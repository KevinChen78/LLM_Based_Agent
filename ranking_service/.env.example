# Ranking service (Phase 2.1) — copy to ranking_service/.env.local and edit.
# All keys optional; these are the defaults.

# HTTP port.
RANKER_PORT=8002

# LightGBM model artifact written by scripts/train_ranker.py.
# Missing file => model_loaded=false => C++ DealRanker falls back to rule scores.
MODEL_PATH=model.txt

# Offline-built per-item aggregates (scripts/build_features.py).
FEATURES_DB=../data/ranking_features.db

# Read-only access to user_profiles (Phase 2.2). Missing table is fine.
SESSIONS_DB_PATH=../data/sessions.db
